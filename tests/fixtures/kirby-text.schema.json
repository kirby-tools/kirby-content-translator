{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "KirbyText split/restore conformance case",
  "description": "Consumed by both the Vitest and PHPUnit KirbyText suites – the corpus is the shared interface of the two implementations.",
  "type": "object",
  "required": [
    "description",
    "sourceText",
    "kirbyTagTypes",
    "kirbyTags",
    "translatedUnitTexts",
    "unitTexts",
    "restoredText"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "sourceText": {
      "type": "string"
    },
    "kirbyTagTypes": {
      "description": "The registered KirbyTag types and aliases, lowercased, as `KirbyText::tagTypes()` lists them – a parenthetical of any other type is prose.",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "kirbyTags": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "translatedUnitTexts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "unitTexts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "restoredText": {
      "type": "string"
    }
  }
}
