{
  "$schema": "./contract.schema.json",
  "skipCases": [
    { "text": "", "skip": true },
    { "text": "   ", "skip": true },
    { "text": "\u00a0", "skip": true },
    { "text": "\ufeff", "skip": true },
    { "text": "\u2009", "skip": true },
    { "text": "\u0000", "skip": false },
    { "text": "\u0085", "skip": false },
    { "text": "\u180e", "skip": false },
    { "text": "\u008542\u0085", "skip": false },
    { "text": "\u00a042\u00a0", "skip": true },
    { "text": "42", "skip": true },
    { "text": "-3.14", "skip": true },
    { "text": "+5", "skip": true },
    { "text": ".5", "skip": true },
    { "text": "5.", "skip": true },
    { "text": "1.5e10", "skip": true },
    { "text": "https://example.com/docs?query=1", "skip": true },
    { "text": "http://localhost:3000", "skip": true },
    { "text": "Hello world", "skip": false },
    { "text": "42 apples", "skip": false },
    { "text": "Visit https://example.com today", "skip": false },
    { "text": "<c0/>", "skip": true },
    { "text": "<c0/> <c1/>", "skip": true },
    { "text": "<c0 />", "skip": true },
    { "text": "Text <c0/>", "skip": false }
  ],
  "rejectionReasons": [
    { "reason": "missing translation", "sourceText": "Hello", "answer": null },
    { "reason": "non-string translation", "sourceText": "Hello", "answer": 42 },
    { "reason": "empty translation", "sourceText": "Hello", "answer": "  " },
    { "reason": "placeholder mismatch", "sourceText": "Read <c0/>", "answer": "Lies" }
  ],
  "batchRouteResponse": {
    "keys": ["texts", "rejections"],
    "rejectionKeys": ["index", "reason"],
    "optionalRejectionKeys": ["expected", "actual"]
  },
  "placeholder": {
    "format": "<c{n}/>",
    "indexBase": 0
  },
  "batching": {
    "maxBatchSize": 50,
    "maxSizePerBatch": 100000
  }
}
