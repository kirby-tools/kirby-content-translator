{
  "$schema": "./contract.schema.json",
  "untranslatableCases": [
    { "text": "", "isUntranslatable": true },
    { "text": "   ", "isUntranslatable": true },
    { "text": "\u00a0", "isUntranslatable": true },
    { "text": "\ufeff", "isUntranslatable": true },
    { "text": "\u2009", "isUntranslatable": true },
    { "text": "\u0000", "isUntranslatable": false },
    { "text": "\u0085", "isUntranslatable": false },
    { "text": "\u180e", "isUntranslatable": false },
    { "text": "\u008542\u0085", "isUntranslatable": false },
    { "text": "\u00a042\u00a0", "isUntranslatable": true },
    { "text": "42", "isUntranslatable": true },
    { "text": "-3.14", "isUntranslatable": true },
    { "text": "+5", "isUntranslatable": true },
    { "text": ".5", "isUntranslatable": true },
    { "text": "5.", "isUntranslatable": true },
    { "text": "1.5e10", "isUntranslatable": true },
    { "text": "https://example.com/docs?query=1", "isUntranslatable": true },
    { "text": "http://localhost:3000", "isUntranslatable": true },
    { "text": "Hello world", "isUntranslatable": false },
    { "text": "42 apples", "isUntranslatable": false },
    { "text": "Visit https://example.com today", "isUntranslatable": false },
    { "text": "<c0/>", "isUntranslatable": true },
    { "text": "<c0/> <c1/>", "isUntranslatable": true },
    { "text": "<c0 />", "isUntranslatable": true },
    { "text": "Text <c0/>", "isUntranslatable": false }
  ],
  "rejectionReasons": [
    { "reason": "missing translation", "sourceText": "Hello", "answer": null },
    { "reason": "non-string translation", "sourceText": "Hello", "answer": 42 },
    { "reason": "empty translation", "sourceText": "Hello", "answer": "  " },
    { "reason": "placeholder mismatch", "sourceText": "Read <c0/>", "answer": "Lies" }
  ],
  "translateUnitsRouteResponse": {
    "keys": ["texts", "rejections"],
    "rejectionKeys": ["index", "reason"],
    "optionalRejectionKeys": ["expectedIndexes", "actualIndexes"]
  },
  "placeholder": {
    "format": "<c{n}/>",
    "indexBase": 0
  },
  "batching": {
    "maxBatchSize": 50,
    "maxSizePerBatch": 100000
  }
}
