{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TS/PHP translation pipeline contract",
  "description": "Examples both pipelines must agree on: the untranslatable-text predicate, the rejection reasons, and the translate-units route's response. Asserted by contract.test.ts and the PHP tests using ContractFixture, so a one-sided edit fails fast.",
  "type": "object",
  "required": [
    "untranslatableCases",
    "rejectionCases",
    "translateUnitsRouteCase"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "untranslatableCases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["sourceText", "isUntranslatable"],
        "additionalProperties": false,
        "properties": {
          "sourceText": {
            "type": "string"
          },
          "isUntranslatable": {
            "type": "boolean"
          }
        }
      }
    },
    "rejectionCases": {
      "description": "A translation that provokes each check, and the reason the check names. Both tiers run every row.",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["sourceText", "translation", "reason"],
        "additionalProperties": false,
        "properties": {
          "sourceText": {
            "type": "string"
          },
          "translation": {
            "type": ["string", "number", "null"]
          },
          "reason": {
            "type": "string"
          }
        }
      }
    },
    "translateUnitsRouteCase": {
      "description": "The texts the translate-units route receives, the translations a strategy returns for them, and the response the route sends. PHP sends the response, the Panel's DeepLStrategy reads it, and nothing else ties the two together.",
      "type": "object",
      "required": ["texts", "translations", "response"],
      "additionalProperties": false,
      "properties": {
        "texts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "translations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "response": {
          "type": "object",
          "required": ["texts", "rejections"],
          "additionalProperties": false,
          "properties": {
            "texts": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string"
              }
            },
            "rejections": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": ["index", "reason"],
                "additionalProperties": false,
                "properties": {
                  "index": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "reason": {
                    "type": "string"
                  },
                  "expectedIndexes": {
                    "type": "array",
                    "items": {
                      "type": "integer"
                    }
                  },
                  "actualIndexes": {
                    "type": "array",
                    "items": {
                      "type": "integer"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
