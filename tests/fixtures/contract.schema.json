{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TS/PHP translation pipeline contract",
  "description": "Values both pipelines must agree on: the skip predicate, the batch route's wire shape, the placeholder scheme, and the AI batching limits. Asserted by contract.test.ts and ContractTest.php so a one-sided edit fails fast.",
  "type": "object",
  "required": [
    "skipCases",
    "rejectionReasons",
    "batchRouteResponse",
    "placeholder",
    "batching"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "skipCases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["text", "skip"],
        "additionalProperties": false,
        "properties": {
          "text": {
            "type": "string"
          },
          "skip": {
            "type": "boolean"
          }
        }
      }
    },
    "rejectionReasons": {
      "description": "The reason each check names, and an answer that provokes it. Both tiers run every row.",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["reason", "sourceText", "answer"],
        "additionalProperties": false,
        "properties": {
          "reason": { "type": "string" },
          "sourceText": { "type": "string" },
          "answer": { "type": ["string", "number", "null"] }
        }
      }
    },
    "batchRouteResponse": {
      "description": "The keys the translate-batch route answers with. PHP writes them, the Panel's DeepLStrategy reads them, and nothing else ties the two literals together.",
      "type": "object",
      "required": ["keys", "rejectionKeys"],
      "additionalProperties": false,
      "properties": {
        "keys": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "rejectionKeys": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        }
      }
    },
    "placeholder": {
      "type": "object",
      "required": ["format", "indexBase"],
      "additionalProperties": false,
      "properties": {
        "format": {
          "type": "string",
          "pattern": "\\{n\\}"
        },
        "indexBase": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "batching": {
      "type": "object",
      "required": ["maxBatchSize", "maxSizePerBatch"],
      "additionalProperties": false,
      "properties": {
        "maxBatchSize": {
          "type": "integer",
          "minimum": 1
        },
        "maxSizePerBatch": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}
