{
  "name": "kirby-content-translator",
  "type": "module",
  "version": "3.18.0",
  "private": true,
  "packageManager": "pnpm@11.28.6",
  "scripts": {
    "dev": "mprocs",
    "build": "kirbyup src/panel/index.ts",
    "build:playground": "PLAYGROUND=true pnpm run build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier \"src/panel/**\" \"tests/panel/**\" \"tests/fixtures/**\" --write",
    "playground:reset": "git checkout -- playground/storage/content && git clean -fdq playground/storage/content",
    "test": "vitest",
    "test:types": "tsc --noEmit",
    "release": "pnpm run build && bumpp --all --execute \"npx zx scripts/pre-release.mjs\" && zx scripts/post-release.mjs"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.5.1",
    "@kirby-tools/licensing": "^0.9.0",
    "@types/node": "^26.6.5",
    "@unocss/eslint-plugin": "^66.11.0",
    "ai": "^7.0.143",
    "ajv": "^8.20.0",
    "bumpp": "^12.3.0",
    "eslint": "^10.13.0",
    "jiti": "^2.7.0",
    "kirby-types": "^1.8.2",
    "kirbyup": "^3.5.0",
    "kirbyuse": "^1.4.2",
    "mprocs": "^0.9.6",
    "p-all": "^5.0.1",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "unocss": "^66.11.0",
    "utilful": "^3.5.1",
    "vite": "^6.4.3",
    "vitest": "^5.0.5",
    "vue": "^2.7.16",
    "yaml": "^2.9.1",
    "zod": "^4.6.7",
    "zx": "^8.8.5"
  }
}
