{
  "name": "kirby-content-translator",
  "type": "module",
  "version": "3.15.0",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "mprocs",
    "build": "kirbyup src/panel/index.ts",
    "build:playground": "PLAYGROUND=true pnpm run build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier \"src/panel/**\" --write",
    "playground:reset": "git checkout -- playground/storage/content && git clean -fdq playground/storage/content",
    "test": "vitest",
    "test:types": "tsc --noEmit",
    "release": "pnpm run build && bumpp --all --execute \"npx zx scripts/pre-release.mjs\" && zx scripts/post-release.mjs"
  },
  "devDependencies": {
    "@ai-sdk/anthropic": "^4.0.49",
    "@ai-sdk/google": "^4.0.64",
    "@ai-sdk/mistral": "^4.0.39",
    "@ai-sdk/openai": "^4.0.60",
    "@ai-sdk/provider": "^4.0.10",
    "@antfu/eslint-config": "^9.5.1",
    "@kirby-tools/licensing": "^0.8.0",
    "@types/node": "^26.4.1",
    "@unocss/eslint-plugin": "^66.10.0",
    "ai": "^7.0.93",
    "ajv": "^8.20.0",
    "bumpp": "^12.3.0",
    "eslint": "^10.10.0",
    "jiti": "^2.7.0",
    "kirby-types": "^1.6.1",
    "kirbyup": "^3.5.0",
    "kirbyuse": "^1.3.1",
    "mprocs": "^0.9.6",
    "ofetch": "^1.5.1",
    "p-all": "^5.0.1",
    "p-map": "^7.0.7",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "ufo": "^1.6.4",
    "unocss": "^66.10.0",
    "utilful": "^3.3.0",
    "vite": "~6.3.7",
    "vitest": "^4.1.11",
    "vue": "^2.7.16",
    "yaml": "^2.9.0",
    "zod": "^4.5.4",
    "zx": "^8.8.5"
  }
}
