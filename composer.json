{
  "name": "johannschopplich/kirby-content-translator",
  "description": "One click translates a whole page, nested blocks included",
  "type": "kirby-plugin",
  "version": "3.18.0",
  "keywords": [
    "kirby",
    "kirby-cms",
    "kirby-plugin",
    "deepl",
    "translation",
    "i18n",
    "multilingual"
  ],
  "license": "proprietary",
  "homepage": "https://kirby.tools/content-translator",
  "authors": [
    {
      "name": "Johann Schopplich",
      "email": "hello@johannschopplich.com",
      "homepage": "https://johannschopplich.com"
    }
  ],
  "require": {
    "php": ">=8.3",
    "getkirby/composer-installer": "^1",
    "johannschopplich/kirby-tools-licensing": "^1.0.0-beta.1",
    "johannschopplich/kirby-tools-utils": "^1.0.0-beta.1"
  },
  "require-dev": {
    "getkirby/cms": "^6.0@beta",
    "phpunit/phpunit": "^12",
    "vlucas/phpdotenv": "^5",
    "getkirby/cli": "^1",
    "medienbaecker/kirby-modules": "^6.0@rc"
  },
  "conflict": {
    "getkirby/cms": "<6"
  },
  "scripts": {
    "dev": [
      "Composer\\Config::disableProcessTimeout",
      "@php -S localhost:8000 -t playground/public vendor/getkirby/cms/router.php"
    ],
    "csfix": "@php tools/phpcs/vendor/bin/php-cs-fixer fix",
    "test": "phpunit",
    "dist": "composer install --no-dev"
  },
  "autoload": {
    "psr-4": {
      "JohannSchopplich\\": "src/classes/"
    }
  },
  "config": {
    "optimize-autoloader": true,
    "allow-plugins": {
      "getkirby/composer-installer": true
    }
  },
  "extra": {
    "kirby-cms-path": false,
    "kirby-plugin-path": "playground/site/plugins",
    "kirby": {
      "compatible": "^6.0"
    }
  }
}
